{
  "expo": {
    "owner": "bassasaurus",
    "name": "D2LB",
    "slug": "direct2lobook",
    "orientation": "portrait",
    "icon": "./app/assets/playstore.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.direct2lobook.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.direct2lobook.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA9NtOrSlaBAfk1EGDTVSSwXYs1GrhYs_M"
        }
      }
    },
    "web": {},
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "direct2logbook",
          "project": "d2lb_mobile"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/D2LB_LOGO_Dark_top.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0f131a"
          }
        }
      ]
    ],
    "userInterfaceStyle": "automatic"
  }
}

{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "beta": {
      "channel": "beta"
    },
    "preview": {
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}

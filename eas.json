{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "beta": {
      "channel": "beta",
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "autoIncrement": true,
        "env": {
          "EXPO_PUBLIC_API_URL": "https://direct2logbook.com"
        }
      }
    },
    "preview": {
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
